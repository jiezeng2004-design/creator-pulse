# CreatorPulse backend configuration
# Copy to .env and fill in values. Never commit real secrets.

# 服务绑定地址（v1 仅允许 localhost，强制安全）
HOST=127.0.0.1
PORT=8001
DEBUG=false

# 项目路径（默认相对于仓库根目录）
# 不要指向项目目录之外的位置
DATA_DIR=../data
BROWSER_PROFILES_DIR=../browser-profiles
DATABASE_URL=sqlite+aiosqlite:///../data/creator_pulse.db

# X (Twitter) 官方 API 凭据
# 获取方式：https://developer.x.com/ → Developer Portal → Projects & Apps → API and Token
# 填 X Developer Portal 生成的 Bearer Token（app-only 即可，无需 Consumer Secret / Access Token）。
# 推荐在「设置 → X API 配置」网页端填写；保存到 backend/.env.x（gitignored），无需编辑本文件。
# 注意：添加 X 账号时需同时填写 X 用户名（不含 @），app-only Token 通过用户名定位账号。
X_BEARER_TOKEN=
# 可选：OAuth 1.0a 应用级凭据（用于代用户请求）
X_CLIENT_ID=
X_CLIENT_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# 功能开关
ENABLE_MOCK_DATA=false        # 全局启用演示数据（所有平台），开启后 UI 顶部显示紫色横幅
DEV_MODE=false                # 开发模式（额外诊断信息，设置页可切换）
ENABLE_SCHEDULED_SYNC=false   # 定时同步（默认关闭，最小间隔 30 分钟）
SYNC_INTERVAL_MINUTES=60      # 定时同步间隔（分钟，最低 30，低于 30 自动修正为 30）
SYNC_MAX_POSTS=50             # 每次同步最大拉取帖子数（1-200）
DATA_RETENTION_DAYS=365       # 数据保留天数（超过自动清理，最低 7 天）

# 日志级别（DEBUG / INFO / WARNING / ERROR / CRITICAL）
LOG_LEVEL=INFO
